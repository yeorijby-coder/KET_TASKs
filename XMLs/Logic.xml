				<condition CNum="1"  CKeyWord="ProductSensor"/>
			</conditions>
			<actions desc ="입고대ON, 화물 감지ON, StartFlag">
				<action ANum="51" AKeyWord="StoStation"/>
				<action ANum="54" AKeyWord="StartFlag"/>
			</actions>
		</Logic>
	</LogicGroup>
	<LogicGroup name="RetStation">
		<Logic id="1" desc="출고대 ON 되는 상황">
			<conditions desc="Dest Self, 화물 ON, 출고대 OFF">
				<condition CNum="11" CKeyWord="DestPos"/>
				<condition CNum="0"  CKeyWord="RetStation"/>
				<condition CNum="6"  CKeyWord="RetStation"/>
				<condition CNum="1"  CKeyWord="ProductSensor"/>
			</conditions>
			<actions desc ="출고대ON, 화물 감지ON, StartFlag">
				<action ANum="51" AKeyWord="RetStation"/>
				<action ANum="51" AKeyWord="ProductSensor"/>
				<action ANum="54" AKeyWord="StartFlag"/>
			</actions>
		</Logic>
		<Logic id="2" desc="목적지가 바뀌었을때">
			<conditions desc="Dest Not Self, 출고대 ON">
				<condition CNum="1"  CKeyWord="RetStation"/>
				<condition CNum="12" CKeyWord="DestPos"/>
				<condition CNum="6"  CKeyWord="RetStation"/>
			</conditions>
			<actions desc ="출고대 강제 OFF">
				<action ANum="58" AKeyWord="RetStation"/>
			</actions>
		</Logic>
	</LogicGroup>
	<LogicGroup name="ArvStation">
		<Logic id="1" desc="시뮬레이터이니까 ??? - SC 입고 H/S 조건이지만 함께 출고대를 ON해줌">
			<conditions desc="작번 有, IsScDest, Auto, 화물 ON">
				<condition CNum="2"  CKeyWord="LuggNum"/>
				<condition CNum="13" CKeyWord="DestPos"/>
				<condition CNum="1"  CKeyWord="Auto"/>
				<condition CNum="1"  CKeyWord="ProductSensor"/>
				<condition CNum="6"  CKeyWord="ArvStation"/>
				<condition CNum="0"  CKeyWord="RetStation"/>
			</conditions>
			<actions desc ="출고대 ON">
				<action ANum="51" AKeyWord="RetStation"/>
			</actions>
		</Logic>
		<Logic id="2" desc="도착대가 비었으면 출고 신호를 내린다">
			<conditions desc="작번 無, 목적지 無, 자동, 화물 OFF, 출고대 ON">
				<condition CNum="3" CKeyWord="LuggNum"/>
				<condition CNum="3" CKeyWord="DestPos"/>
				<condition CNum="1" CKeyWord="Auto"/>
				<condition CNum="0" CKeyWord="ProductSensor"/>
				<condition CNum="1" CKeyWord="RetStation"/>
				<condition CNum="6" CKeyWord="ArvStation"/>
			</conditions>
			<actions desc ="출고대 강제 OFF">
				<action ANum="58" AKeyWord="RetStation"/>
			</actions>
		</Logic>
		<Logic id="3" desc="가장 정상적인 도착대의 조건">
			<conditions desc="작번 有, Dest Self, Auto, 화물 ON">
				<condition CNum="2"  CKeyWord="LuggNum"/>
				<condition CNum="11" CKeyWord="DestPos"/>
				<condition CNum="1"  CKeyWord="Auto"/>
				<condition CNum="1"  CKeyWord="ProductSensor"/>
				<condition CNum="0"  CKeyWord="RetStation"/>
				<condition CNum="6"  CKeyWord="ArvStation"/>
			</conditions>
			<actions desc ="출고대 ON">
				<action ANum="51" AKeyWord="RetStation"/>
			</actions>
		</Logic>
	</LogicGroup>

	<LogicGroup name="ScStoHS">
		<Logic id="1" desc="[OR 조건] NoLugg 반전">
