<?xml version="1.0" encoding="utf-8"?>
<LogicDatas>
	<LogicGroup name="ForkLift">
		<Logic id="1" desc="지게차가 화물을 올려놓은 경우">
			<conditions desc="NoLugg, NoDest, 화물 OFF, 입고대 OFF">
				<condition CNum="3"  CKeyWord="LuggNum"/>
				<condition CNum="3"  CKeyWord="DestPos"/>
				<condition CNum="0"  CKeyWord="StoStation"/>
				<condition CNum="6"  CKeyWord="StoStation"/>
				<condition CNum="1"  CKeyWord="Auto"/>
				<condition CNum="0"  CKeyWord="ProductSensor"/>
			</conditions>
			<actions desc ="화물감지 ON, StartFlagOn">
				<action ANum="51" AKeyWord="ProductSensor"/>
				<action ANum="54" AKeyWord="StartFlag"/>
			</actions>
		</Logic>
		<Logic id="2" desc="지게차가 화물을 올려놓고 특정시간 지난 경우">
			<conditions desc="NoLugg, NoDest, 화물 ON, 입고대 OFF">
				<condition CNum="3"  CKeyWord="LuggNum"/>
				<condition CNum="3"  CKeyWord="DestPos"/>
				<condition CNum="0"  CKeyWord="StoStation"/>
				<condition CNum="6"  CKeyWord="StoStation"/>
				<condition CNum="1"  CKeyWord="ProductSensor"/>
				<condition CNum="1"  CKeyWord="Auto"/>
				<condition CNum="15" CKeyWord="5"/>
			</conditions>
			<actions desc ="입고대 ON, StartFlag Off">
				<action ANum="51" AKeyWord="StoStation"/>
				<action ANum="55" AKeyWord="StartFlag"/>
			</actions>
		</Logic>
		
		<Logic id="4" desc="지게차가 화물 들어낸 경우(출고대)">
			<conditions desc="목적지 자기자신, 시간경과">
				<condition CNum="11" CKeyWord="DestPos"/>
				<condition CNum="1"  CKeyWord="ProductSensor"/>
				<condition CNum="1"  CKeyWord="RetStation"/>
				<condition CNum="6"  CKeyWord="RetStation"/>
			</conditions>
			<actions desc ="화물 OFF, StartFlagOn">
				<action ANum="58" AKeyWord="ProductSensor"/>
				<action ANum="54" AKeyWord="StartFlag"/>
			</actions>
		</Logic>
		<Logic id="5" desc="지게차가 화물을 떠가고 난후">
			<conditions desc="작번 有, Dest Self, 화물 OFF">
				<condition CNum="2"  CKeyWord="LuggNum"/>
				<condition CNum="11" CKeyWord="DestPos"/>
				<condition CNum="0"  CKeyWord="ProductSensor"/>
				<condition CNum="6"  CKeyWord="RetStation"/>
				<condition CNum="15" CKeyWord="5"/>
			</conditions>
			<actions desc ="Track Data 삭제, StartFlagOff (Auto OFF 는 뺐다 - 구역 비트라 지게차가 가져갈 때마다 PLC 전체가 수동으로 떨어졌다)">
				<action ANum="57" AKeyWord="LuggNum"/>
				<action ANum="57" AKeyWord="DestPos"/>
				<action ANum="57" AKeyWord="D5n+1"/>
				<action ANum="57" AKeyWord="SensorData"/>
				<action ANum="57" AKeyWord="ErrorCode"/>
				<action ANum="57" AKeyWord="D5n+4"/>
				<action ANum="55" AKeyWord="StartFlag"/>
			</actions>
		</Logic>
	</LogicGroup>
	
	<LogicGroup name="StoStation">
		<Logic id="1" desc="입고대에서 작업번호 기록될때">
			<conditions desc="작업번호있고, 입고대 ON">
