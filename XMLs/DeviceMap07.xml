	<UseScDest use="1" from="1" to="11" list="" listDesc="list의 구분자는 ,(콤마)임!"/>
	<TrackingArea keywords="LuggNum, JobType, DestPos" desc="Keywords는 DeviceMap.xml마다 (순서도) 다 같아야 함!">
		<KeyWord>LuggNum</KeyWord>
		<KeyWord>JobType</KeyWord>
		<KeyWord>DestPos</KeyWord>
	</TrackingArea>
	
	<!--한 트랙당 워드수가 2,4,5일때-->
	<TrackDatas Count="28" desc="하위Node의 type=>Byte(B),Nibble(N),Word(W),bit(b),Multi(M)">
		<Word type="W" addr="D5n+0" name="LuggNum" />
		<Word type="B" addr="D5n+1" name="D5n+1" desc="Type이 M 일때는 하위의 엘리먼트 값을 아래처럼 지정해줘야 한다.(ByteL,Nibble0,Bit0,BitF) ">
			<ByteL name="DestPos"/>
			<ByteH name="JobType"/>
		</Word>
		<Word type="b" addr="D5n+2" name="SensorData">
			<Bit name="ProductSensor" desc="D5n+2.0"/>
		</Word>
		<Word type="W" addr="D5n+3" name="ErrorCode" />
		<Word type="W" addr="D5n+4" name="D5n+4" />
	</TrackDatas>

