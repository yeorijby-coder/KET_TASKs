                pPort = sb.ToString();

                pRtnMsg = "[GsGetInitPorFileDB]::Sucess";
                return;
            }
            catch (Exception ex)
            {
                pRtnMsg = ex.Message;
            }
            pRtnMsg = "[GsGetInitPorFileDB]Error::" + pRtnMsg;
        }

